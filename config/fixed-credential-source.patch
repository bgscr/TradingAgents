+# A machine-specific release may pin this tuple IN its reviewed and hashed
+# reader: (host, deployment path, (volume, file ID), owner path, (volume, file ID)).
+# Never populate it from environment, command line, or a mutable settings file.
+_FIXED_RELEASE = None
+
+
+@cache
+def _local_host():
+    # Queried before the financial worker installs its no-socket audit hook.
+    from socket import gethostname
+    return gethostname().casefold()
+
+
+def _checked_directory(path, identity):
+    if (not path.is_absolute() or len(path.drive) != 2 or path.drive[1] != ':'
+            or '..' in path.parts):
+        raise ProjectCredentialError('project_env_source_mismatch')
+    for item in (path, *path.parents):
+        info = item.lstat()
+        if not stat.S_ISDIR(info.st_mode) or getattr(info, 'st_file_attributes', 0) & 0x400:
+            raise ProjectCredentialError('project_env_linked_path')
+    info = path.stat()
+    if not info.st_ino or (info.st_dev, info.st_ino) != identity:
+        raise ProjectCredentialError('project_env_source_mismatch')
+
+
+def credential_file(source):
+    root = Path(source).absolute()
+    if _FIXED_RELEASE is None:
+        return root / '.env'
+    host, deployment, deployment_id, project, project_id = _FIXED_RELEASE
+    owner = Path(project)
+    if (os.name != 'nt' or _local_host() != host or root != Path(deployment)
+            or Path(__file__).absolute().parent.parent != root
+            or owner.parent != root.parent or owner == root):
+        raise ProjectCredentialError('project_env_source_mismatch')
+    _checked_directory(root, deployment_id)
+    _checked_directory(owner, project_id)
+    return owner / '.env'
+
